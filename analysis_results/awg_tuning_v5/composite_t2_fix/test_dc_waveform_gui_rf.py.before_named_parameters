    assert frequencies == [450.0]
    assert lookup == {
        "run_id": 42,
        "nqz": 2,
        "output_filter_type": "highpass",
        "output_filter_cutoff_ghz": 1.5,
        "output_filter_bandwidth_ghz": 0.4,
    }
    assert calls["nominal"] == (
