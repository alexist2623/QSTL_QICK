        {
            "reference_response_dbm": -5.0,
            "output_att1_db": 10.0,
            "output_att2_db": 5.0,
        },
    )
    assert calls["predicted"] == (
        [450.0],
        [1234],
        {
            "output_att1_db": 10.0,
            "output_att2_db": 5.0,
        },
    )
    assert "Run 42" in panel.power_calibration_status.text()

