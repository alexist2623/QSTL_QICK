--- v2/timing.xdc
+++ v3/timing.xdc
@@ -1,81 +1,21 @@
 # Authors: Jeonghyun Park (jeonghyun.park@ubc.ca or alexist@snu.ac.kr), Farbod
 # 300 MHz external CLK104 PL clock; rounded slightly down for timing analysis.
 create_clock -name clk_104_pl -period 3.333 [get_ports CLK104_PL_CLK_P]
-# create_clock -name clk_104_sysref -period 200.0 [get_ports CLK104_PL_SYSREF_P]
+# The BD connects tProcessor, AWG, RF DDS, FIR, and DDR source stream to the
+# same dac_clk_buf/BUFG_O net. Their data/trigger paths are synchronous and
+# remain timed at 3.333 ns. The old clk_core cell and RFDC clk_adc2/clk_dac1
+# output nets are absent/disconnected in this BD; they are not clock domains.
+set clk_axi [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/usp_rf_data_converter_0/s_axi_aclk]]]
+set clk_ddr4 [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/ddr4/ddr4_0/c0_ddr4_ui_clk]]]
 
-set clk_axi [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/usp_rf_data_converter_0/s_axi_aclk]]]
+# Keep the three existing asynchronous domain crossings: host AXI, common
+# 300 MHz fabric, and DDR UI memory clock (internal async FIFO/CDC bridges).
+set_clock_groups -name clk_axi_to_dac0 -asynchronous \
+    -group $clk_axi -group [get_clocks clk_104_pl]
+set_clock_groups -name clk_axi_to_ddr4 -asynchronous \
+    -group $clk_axi -group $clk_ddr4
+set_clock_groups -name clk_ddr4_to_clk104_pl -asynchronous \
+    -group $clk_ddr4 -group [get_clocks clk_104_pl]
 
-# tProc core
-set clk_core [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/clk_core/clk_out1]]]
-
-# ADC/DAC
-set clk_adc2  [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/usp_rf_data_converter_0/clk_adc2]]]
-
-set clk_dac2 [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/dac_clk_buf/BUFG_O]]]
-
-# this is also tProc timing clock
-set clk_dac1 [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/usp_rf_data_converter_0/clk_dac1]]]
-
-set clk_ddr4  [get_clocks -of_objects [get_nets -of_objects [get_pins d_1_i/ddr4/ddr4_0/c0_ddr4_ui_clk]]]
-
-# AXI clock to data clocks
-set_clock_group -name clk_axi_to_adc2 -asynchronous \
-    -group [get_clocks $clk_axi] \
-    -group [get_clocks $clk_adc2]
-
-set_clock_group -name clk_axi_to_dac2 -asynchronous \
-    -group [get_clocks $clk_axi] \
-    -group [get_clocks $clk_dac1]
-
-set_clock_group -name clk_axi_to_dac0 -asynchronous \
-    -group [get_clocks $clk_axi] \
-    -group [get_clocks $clk_dac2]
-
-# tProc timing clock to generator clocks
-set_clock_group -name clk_tproc_to_dac0 -asynchronous \
-    -group [get_clocks $clk_dac1] \
-    -group [get_clocks $clk_dac2]
-
-set_clock_group -name clk_tproc_to_adc2 -asynchronous \
-    -group [get_clocks $clk_dac2] \
-    -group [get_clocks $clk_adc2]
-
-set_clock_group -name clk_axi_to_core -asynchronous \
-    -group [get_clocks $clk_axi] \
-    -group [get_clocks $clk_core]
-
-# tProc core clock and timing clocks
-set_clock_group -name clk_core_to_tproc -asynchronous \
-    -group [get_clocks $clk_core] \
-    -group [get_clocks $clk_dac2]
-
-# tProc core clock and readout clocks (for readouts that drive tProc inputs)
-set_clock_group -name clk_core_to_adc2 -asynchronous \
-    -group [get_clocks $clk_core] \
-    -group [get_clocks $clk_adc2]
-
-# AXI clock and DDR4 clock
-set_clock_group -name clk_axi_to_ddr4 -asynchronous \
-    -group [get_clocks $clk_axi] \
-    -group [get_clocks $clk_ddr4]
-
-# AXI clock and readout data clock
-set_clock_group -name clk_ddr4_to_adc2 -asynchronous \
-    -group [get_clocks $clk_ddr4] \
-    -group [get_clocks $clk_adc2]
-
-# DDR sample capture CDC.
-# The axis_buffer_ddr_sample_v3 IP crosses from the external readout sample
-# clock to the DDR UI clock through its internal async FIFO. In this project
-# the failing source/readout clock is the explicitly-created clk_104_pl clock,
-# not the RFDC-derived clk_adc2 object above, so constrain that crossing too.
-set_clock_group -name clk_ddr4_to_clk104_pl -asynchronous \
-    -group [get_clocks $clk_ddr4] \
-    -group [get_clocks clk_104_pl]
-
-# readout triggers
-set_false_path -through [get_pins d_1_i/qick_processor_0/trig_*_o]
-
-# reset
-set_false_path -through [get_pins d_1_i/rst_dac2/peripheral_aresetn[0]]
+# Retain the existing common fabric reset exception.
 set_false_path -through [get_pins d_1_i/rst_dac0/peripheral_aresetn[0]]
